{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/$1"
    },
    {
      "source": "/beats/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Applebot|Iframely|MetaInspector|SkypeUriPreview|redditbot|vkShare).*"
        }
      ],
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/share/beat/:id"
    },
    {
      "source": "/release/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Applebot|Iframely|MetaInspector|SkypeUriPreview|redditbot|vkShare).*"
        }
      ],
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/share/release/:slug"
    },
    {
      "source": "/gallery/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Applebot|Iframely|MetaInspector|SkypeUriPreview|redditbot|vkShare).*"
        }
      ],
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/share/gallery/:id"
    },
    {
      "source": "/services",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Applebot|Iframely|MetaInspector|SkypeUriPreview|redditbot|vkShare).*"
        }
      ],
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/share/services/all"
    },
    {
      "source": "/services/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Applebot|Iframely|MetaInspector|SkypeUriPreview|redditbot|vkShare).*"
        }
      ],
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/share/services/:slug"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/beats",
      "destination": "/beats/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
