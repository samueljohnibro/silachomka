{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://silachomka-api.samueljohnibrotech.workers.dev/api/$1"
    },
    {
      "source": "/beats",
      "destination": "/beats/index.html"
    },
    {
      "source": "/beats/:id",
      "destination": "/beats/:id/index.html"
    },
    {
      "source": "/gallery/:id",
      "destination": "/gallery/:id/index.html"
    },
    {
      "source": "/release/:slug",
      "destination": "/release/:slug/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
